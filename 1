  }
  $('#view').innerHTML = `${LOCAL_SMT ? cloudPanelHtml(false) : ''}<div class="panel"><div class="toolbar"><div class="grow"><b>${esc(t('sendSmt'))}</b><div class="sum" style="margin:0">${esc(t('sendHint'))}</div></div><button class="btn primary" data-action="sendSmt">${esc(t('sendSmt'))}</button></div></div>${myPanel}
  <div class="panel"><div class="grid">
