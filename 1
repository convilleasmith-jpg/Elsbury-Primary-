const LANG_SUBJECT = {Afrikaans:'Afrikaans (Huistaal & EAT)', English:'Engels (Huistaal & EAT)'};
function actKeywords(a){
  const lk = a.language==='English' ? 'en' : 'af', pre = STR[a.strand][lk];
  let ens = [];
  if(a.strand==='A' || a.strand==='D') ens = a.items || [];
  else if(a.strand==='B') ens = a.ttype ? [a.ttype] : [];
  else if(a.strand==='C') ens = a.genre ? [a.genre] : [];
  return ens.map(en => { const o = ALL.find(x => x.en===en); return pre + ': ' + (o ? o[lk] : en); });
}
function allRecords(){
  const out = state.atp.records.slice();
  state.acts.forEach(a => {
    if(a.status !== 'done' || !ATP[a.grade]) return;
    const subj = LANG_SUBJECT[a.language], list = ATP[a.grade][subj] || [];
    actKeywords(a).forEach(kw => { if(list.includes(kw)) out.push({grade:a.grade,cls:a.cls,subject:subj,kw:kw,date:a.doneOn || a.planned || '',teacher:a.teacher || '',derived:true}); });
  });
  return out;
}
function mySubjects(){
  const m = {};
  DAYS.forEach(d => state.timetable[d].forEach(p => {
    if(p.cls && p.subject){
      const g = p.cls[0], k = g + '|' + p.subject;
      const e = m[k] = m[k] || {grade:g, subject:p.subject, classes:new Set(), periods:0};
      e.classes.add(p.cls[1]); e.periods++;
    }
  }));
  return Object.values(m).sort((x, y) => x.grade.localeCompare(y.grade) || x.subject.localeCompare(y.subject));
}
function countDone(recs, g, c, sub){
  const list = ATP[g][sub];
  return new Set(recs.filter(r => r.grade===g && r.cls===c && r.subject===sub && list.includes(r.kw)).map(r => r.kw)).size;
}
function renderAtp(){
  const s = state.atp.sel, recs = allRecords(), mine = mySubjects();
  const unset = DAYS.reduce((n, d) => n + state.timetable[d].filter(p => p.cls && !p.subject).length, 0);
  let myPanel;
  if(!mine.length){
    myPanel = `<div class="panel"><h2>${esc(t('mySubjects'))}</h2><div class="empty">${esc(t('noTimetable'))}<div class="actions" style="justify-content:center"><button class="btn" data-action="tab" data-v="tt">${esc(t('goTt'))}</button></div></div></div>`;
  } else {
    const rows = mine.map(m => {
      const tot = ATP[m.grade][m.subject].length;
      const cl = [...m.classes].sort().map(c => `<span class="chip">${m.grade}${c}: ${countDone(recs, m.grade, c, m.subject)}/${tot}</span>`).join(' ');
      const on = s.grade===m.grade && s.subject===m.subject;
      return `<tr><td>${esc(m.subject)}</td><td>${m.grade}</td><td style="text-align:left">${cl}</td><td>${m.periods}</td>
        <td><button class="btn small${on ? ' primary' : ''}" data-action="pickSubj" data-g="${m.grade}" data-s="${esc(m.subject)}">${esc(t('showTable'))}</button></td></tr>`;
    }).join('');
    myPanel = `<div class="panel"><h2>${esc(t('mySubjects'))}</h2><div class="scroll"><table>
      <tr><th>${esc(t('subject'))}</th><th>${esc(t('grade'))}</th><th>${esc(t('classes'))}</th><th>${esc(t('periodsWeek'))}</th><th></th></tr>${rows}</table></div>
      ${unset ? `<div class="msg">${unset} ${esc(t('noSubj'))}</div>` : ''}</div>`;
  }
  const subjects = s.grade ? Object.keys(ATP[s.grade]) : [];
  if(s.subject && !subjects.includes(s.subject)) s.subject = '';
  let table = '';
  if(s.grade && !s.subject){
    const rows = subjects.map(sub => {
      const tot = ATP[s.grade][sub].length;
      const cells = CLASSES.map(c => { const n = countDone(recs, s.grade, c, sub);
