      return `<tr><td>${esc(sub)}</td>${cells}</tr>`;
    }).join('');
    table = `<div class="panel"><div class="scroll"><table><tr><th>${esc(t('subject'))}</th>${CLASSES.map(c => `<th>${esc(s.grade + c)}</th>`).join('')}</tr>${rows}</table></div></div>`;
  } else if(s.grade && s.subject){
    const list = ATP[s.grade][s.subject], rec = {};
    recs.filter(r => r.grade===s.grade && r.subject===s.subject).forEach(r => { rec[r.cls + '|' + r.kw] = r; });
    const tot = list.length, sums = CLASSES.map(c => list.filter(k => rec[c + '|' + k]).length);
    const own = [...new Set(recs.filter(r => r.grade===s.grade && r.subject===s.subject && !list.includes(r.kw)).map(r => r.kw))];
    const extraRows = own.length ? `<tr class="sectrow" style="--c:var(--brand)"><td colspan="5">${esc(t('ownRows'))}</td></tr>` + own.map(k => `<tr><td>${esc(k)} <span class="chip">${esc(t('ownTag'))}</span></td>${CLASSES.map(c => { const r = rec[c + '|' + k]; return r ? `<td title="${esc(r.date)}"><span class="tick">✓</span><small class="dt">${esc((r.date || '').slice(5))}</small></td>` : '<td></td>'; }).join('')}</tr>`).join('') : '';
    const rows = list.map(k => `<tr><td>${esc(k)}${subsFor(s.grade, k).length ? `<div class="subl">${subsFor(s.grade, k).map(esc).join(' · ')}</div>` : ''}</td>${CLASSES.map(c => {
      const r = rec[c + '|' + k];
      return r ? `<td title="${esc(r.date + (r.teacher ? ', ' + r.teacher : ''))}"><span class="tick">✓</span><small class="dt">${esc((r.date || '').slice(5))}</small></td>` : '<td></td>';
    }).join('')}</tr>`).join('');
    table = `<div class="panel"><div class="scroll"><table class="kwt"><tr><th>${esc(t('keyword'))}</th>${CLASSES.map(c => `<th>${esc(s.grade + c)}</th>`).join('')}</tr>
