const hashKw = str => { let h = 5381; for(let i = 0; i < str.length; i++) h = ((h * 33) ^ str.charCodeAt(i)) >>> 0; return h.toString(36) + str.length.toString(36); };
const slugSubj = str => str.replace(/[^A-Za-z0-9]+/g, '_').replace(/^_|_$/g, '').slice(0, 40) + '-' + hashKw(str);
function myGroups(){
  const g = {}, me = state.profile.name;
  allRecords().forEach(r => {
    if(r.teacher && r.teacher !== me) return;
    const list = ATP[r.grade] && ATP[r.grade][r.subject]; if(!list) return;
    const key = r.grade + '-' + slugSubj(r.subject);
    const o = g[key] = g[key] || {grade:r.grade, subject:r.subject, ticks:{}, own:[]};
    if(list.includes(r.kw)){ (o.ticks[r.cls] = o.ticks[r.cls] || {})[hashKw(r.kw)] = r.date || ''; }
    else o.own.push({c:r.cls, k:r.kw, d:r.date || ''});
  });
  return g;
}
const taughtSummary = () => mySubjects().map(m => ({g:m.grade, s:m.subject, c:[...m.classes].sort(), p:m.periods}));
function sheetView(){
  const me = state.profile.name, rec = allRecords().filter(r => !r.teacher || r.teacher === me), combos = {};
  mySubjects().forEach(m => { combos[m.grade + '|' + m.subject] = {g:m.grade, s:m.subject, classes:new Set(m.classes)}; });
  rec.forEach(r => { const k = r.grade + '|' + r.subject; const o = combos[k] = combos[k] || {g:r.grade, s:r.subject, classes:new Set()}; o.classes.add(r.cls); });
  return Object.values(combos).sort((a, b) => a.g.localeCompare(b.g) || a.s.localeCompare(b.s)).map(o => {
    const list = (ATP[o.g] && ATP[o.g][o.s]) || [], classes = [...o.classes].sort(), by = {};
    const mine = rec.filter(r => r.grade === o.g && r.subject === o.s);
    mine.forEach(r => { by[r.cls + '|' + r.kw] = r.date || 'x'; });
    const rows = list.map(k => [k, classes.map(c => by[c + '|' + k] || ''), 0]);
    [...new Set(mine.filter(r => !list.includes(r.kw)).map(r => r.kw))].forEach(k => rows.push([k, classes.map(c => by[c + '|' + k] || ''), 1]));
    return {g:o.g, s:o.s, classes:classes, rows:rows};
  });
}
