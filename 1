function csvCell(v){ v = String(v == null ? '' : v); return /[",\n]/.test(v) ? '"'+v.replace(/"/g,'""')+'"' : v; }
function buildCsv(){
  const head = ['Language','Grade','Class','Term','Week','Date planned','Teacher','Strand','Topic','Details','Status','Date completed','SBA task','SBA marks','Notes'];
  const rows = filtered().map(a => [a.language,a.grade,a.cls,a.term,a.week,a.planned,a.teacher,a.strand+'. '+STR[a.strand].en,a.title,summary(a).replace(/ \| /g,'; '),
    a.status,a.doneOn,a.sba&&a.sba.on?(a.sba.name||'Yes'):'',a.sba&&a.sba.on?a.sba.marks:'',a.notes]);
  return [head].concat(rows).map(r => r.map(csvCell).join(',')).join('\n');
}
function closeModal(){ form = null; formErr = ''; exportText = null; copiedFlag = false; renderModal(); }
function refreshView(){ if(state.tab==='dash') renderDash(); else if(state.tab==='plan') renderList(); else renderAtp(); }

function act(name, el, e){
  const id = el.dataset.id;
  switch(name){
    case 'ui': state.ui = el.dataset.v; persist(); render(); break;
    case 'tab': state.tab = el.dataset.v; logNote = ''; persist(); render(); break;
    case 'group': { const inT = TEACH_TABS.includes(state.tab), g = el.dataset.v;
      if(g==='teach' && !inT) state.tab = 'log'; else if(g==='taal' && (inT || state.tab==='smt')) state.tab = 'words'; else if(g==='smt') state.tab = 'smt';
      logNote = ''; persist(); render(); break; }
    case 'ttDay': state.ttDay = el.dataset.v; persist(); renderTimetable(); break;
    case 'pickSubj': state.atp.sel.grade = el.dataset.g; state.atp.sel.subject = el.dataset.s; persist(); renderAtp(); break;
    case 'saveName': { const inp = $('#profName'), v = inp ? inp.value.trim() : ''; if(!v) break; setUser(v); break; }
    case 'changeUser': setUser(''); break;
    case 'logSave': {
      const p = +el.dataset.p, key = logDate + '|' + p, slot = state.timetable[dayKey(logDate)][p - 1], d = draftFor(p);
      if(!d.kws.length || !slot || !slot.cls) break;
      const grade = slot.cls[0], c = slot.cls[1], old = findLog(logDate, p);
      const oldKws = old ? logKws(old) : [];
      const oldIds = old ? (old.atpIds || (old.atpId && old.kw ? {[old.kw]: old.atpId} : {})) : {};
      oldKws.forEach(k => { if(!d.kws.includes(k) && oldIds[k]) state.atp.records = state.atp.records.filter(r => r.id !== oldIds[k]); });
      const newIds = {};
      d.kws.forEach(k => {
        if(oldKws.includes(k) && oldIds[k]){ newIds[k] = oldIds[k]; return; }
        if(!state.atp.records.some(r => r.grade===grade && r.cls===c && r.subject===slot.subject && r.kw===k)){
          const id = uid(); newIds[k] = id;
          state.atp.records.push({id:id,grade:grade,cls:c,subject:slot.subject,kw:k,term:String(currentTerm()),teacher:state.profile.name,date:logDate});
        }
      });
      const subsOut = {}; d.kws.forEach(k => { const all = subsFor(grade, k); if(all.length) subsOut[k] = (d.subs && d.subs[k]) ? d.subs[k].slice() : all.slice(); });
      const rec = {id: old ? old.id : uid(), date:logDate, period:p, grade:grade, cls:c, subject:slot.subject, topic:d.topic, kws:d.kws.slice(), subs:subsOut, covered:d.covered, teacher:state.profile.name, atpIds:newIds};
      if(old) state.logs[state.logs.indexOf(old)] = rec; else state.logs.push(rec);
      delete drafts[key]; logNote = t('lessonLogged'); persist(); renderLog(); break; }
    case 'lgOwn': { const p = +el.dataset.p, inp = $('#own-' + p), v = inp ? inp.value.trim() : ''; if(!v) break;
      const key = logDate + '|' + p, d = drafts[key] = drafts[key] || draftFor(p);
      if(!d.kws.includes(v)) d.kws.push(v); renderLog(); break; }
    case 'cloudSend': doCloud(true); break;
    case 'cloudLoad': window.__cloudAuto = true; loadCloud(); break;
    case 'backup': exportKind = 'backup'; exportText = JSON.stringify(state, null, 1); copiedFlag = false; smtMsg = ''; renderModal(); break;
    case 'restoreNow': { const ta = $('#restoreText'); if(ta && restoreFrom(ta.value)){ smtMsg = ''; closeModal(); render(); } else { smtMsg = t('restoreBad'); renderModal(); } break; }
    case 'sendSmt': exportKind = 'progress'; exportText = JSON.stringify(progressPayload(), null, 1); copiedFlag = false; renderModal(); break;
    case 'dlFile': { const ta = $('#csvOut'); try{
        const blob = new Blob([ta.value], {type:'application/json'}), a = document.createElement('a');
        a.href = URL.createObjectURL(blob); a.download = (exportKind==='backup' ? 'ATP-rugsteun-' : 'ATP-vordering-') + ((state.profile.name || 'onderwyser').replace(/[^A-Za-z0-9]+/g, '_')) + (exportKind==='backup' ? '-' + new Date().toISOString().slice(0, 10) : '') + '.json';
        document.body.appendChild(a); a.click(); a.remove();
      }catch(err){} break; }
    case 'smtPaste': { const ta = $('#smtPaste'); const ok = ta && importProgress(ta.value); smtMsg = ok ? '1 ' + t('impOk') : t('impBad'); if(ok){ ta.value = ''; persist(); } renderSmt(); break; }
    case 'smtDel': state.smtImport = state.smtImport.filter(x => x.id !== el.dataset.n); if(smtOpen.startsWith(el.dataset.n + '|')) smtOpen = ''; persist(); renderSmt(); break;
    case 'smtRefresh': smtData = null; smtErr = ''; loadSmt(); break;
    case 'smtOpen': smtOpen = (smtOpen === el.dataset.k) ? '' : el.dataset.k; renderSmt(); break;
    case 'lgRm': { const p = +el.dataset.p, key = logDate + '|' + p; const d = drafts[key] = drafts[key] || draftFor(p);
      d.kws = d.kws.filter(k => k !== el.dataset.val); if(d.subs) delete d.subs[el.dataset.val]; renderLog(); break; }
    case 'lgSub': { const p = +el.dataset.p, key = logDate + '|' + p; const d = drafts[key] = drafts[key] || draftFor(p);
      const sl = state.timetable[dayKey(logDate)][p - 1], k = d.kws[+el.dataset.ki], all = subsFor(sl.cls[0], k);
      if(!d.subs) d.subs = {};
      const cur = d.subs[k] ? d.subs[k].slice() : all.slice(), sh = all[+el.dataset.i], ix = cur.indexOf(sh);
      if(ix >= 0) cur.splice(ix, 1); else cur.push(sh);
      d.subs[k] = cur; renderLog(); break; }
    case 'atpDone': {
      const s = state.atp.sel;
      if(!s.grade || !s.cls || !s.subject || !s.kw){ atpMsg = t('pickAll'); renderAtp(); break; }
      if(state.atp.records.some(r => r.grade===s.grade && r.cls===s.cls && r.subject===s.subject && r.kw===s.kw)){ atpMsg = t('already'); renderAtp(); break; }
      state.atp.records.push({id:uid(),grade:s.grade,cls:s.cls,subject:s.subject,kw:s.kw,term:s.term,teacher:s.teacher,date:s.date || today()});
      s.kw = ''; atpMsg = ''; persist(); renderAtp(); break; }
    case 'atpUndo': state.atp.records = state.atp.records.filter(r => r.id!==id); persist(); renderAtp(); break;
    case 'addTeacher': {
      const inp = $('#newTeacher' + el.dataset.ctx); const v = inp ? inp.value.trim() : '';
      if(!v) break;
      if(!state.teachers.includes(v)) state.teachers.push(v);
      if(el.dataset.ctx==='Atp') state.atp.sel.teacher = v; else if(form) form.teacher = v;
      persist(); if(el.dataset.ctx==='Atp') renderAtp(); else renderModal(); break; }
    case 'new': form = newForm(); formErr = ''; renderModal(); break;
    case 'edit': { const a = state.acts.find(x => x.id===id); if(a){ form = JSON.parse(JSON.stringify(a)); formErr = ''; renderModal(); } break; }
    case 'complete': { const a = state.acts.find(x => x.id===id); if(a){ a.status='done'; a.doneOn = today(); persist(); refreshView(); } break; }
    case 'reopen': { const a = state.acts.find(x => x.id===id); if(a){ a.status='progress'; a.doneOn=''; persist(); renderList(); } break; }
    case 'del':
      if(armed===id){ state.acts = state.acts.filter(x => x.id!==id); armed = null; persist(); renderList(); }
      else { armed = id; renderList(); setTimeout(() => { if(armed===id){ armed=null; if(state.tab==='plan') renderList(); } }, 4000); }
      break;
    case 'clearFlt': state.filters = baseState().filters; persist(); renderPlanner(); break;
    case 'export': exportKind = 'csv'; exportText = buildCsv(); copiedFlag = false; renderModal(); break;
    case 'copyCsv': { const ta = $('#csvOut'); ta.select();
      let ok = false;
      try{ if(navigator.clipboard){ navigator.clipboard.writeText(ta.value); ok = true; } }catch(err){}
      if(!ok){ try{ ok = document.execCommand('copy'); }catch(err){} }
      copiedFlag = ok; if(ok){ el.textContent = t('copied'); } break; }
    case 'closeModal': if(e.target === el) closeModal(); break;
    case 'closeModal2': closeModal(); break;
    case 'rmItem': { const i = form.items.indexOf(el.dataset.val); if(i>=0) form.items.splice(i,1); renderModal(); break; }
    case 'addCustom': { const inp = $('#customIn'), v = inp.value.trim(); if(!v) break;
      const s = form.strand; if((s==='A' || s==='D') && !state.custom[s].includes(v) && !ALL.some(o => o.en===v)) state.custom[s].push(v);
      if(!form.items.includes(v)) form.items.push(v); persist(); renderModal(); break; }
    case 'toggleStage': { const k = el.dataset.k; form.stages[k] = form.stages[k] ? '' : today(); renderModal(); break; }
    case 'saveForm': {
      if(!form.title.trim()){ formErr = t('needTitle'); renderModal(); break; }
      const rec = JSON.parse(JSON.stringify(form)); rec.title = rec.title.trim();
      if(rec.status==='done'){ if(!rec.doneOn) rec.doneOn = today(); } else rec.doneOn = '';
      if(!rec.id){ rec.id = uid(); state.acts.push(rec); } else { const i = state.acts.findIndex(x => x.id===rec.id); if(i>=0) state.acts[i] = rec; }
      persist(); closeModal(); refreshView(); break;
    }
  }
}
document.addEventListener('click', e => { const b = e.target.closest('[data-action]'); if(b) act(b.dataset.action, b, e); });
function onField(e){
  const el = e.target;
  if(el.dataset.add && form){
    if(e.type==='change' && el.value){ if(!form.items.includes(el.value)) form.items.push(el.value); renderModal(); }
  } else if(el.dataset.f && form){
    const v = el.type==='checkbox' ? el.checked : el.value;
    setField(el.dataset.f, v);
    if(el.dataset.rr && e.type==='change') renderModal();
  } else if(el.dataset.restorefile){
    if(e.type==='change' && el.files && el.files[0]){
      el.files[0].text().then(tx => { if(restoreFrom(tx)){ smtMsg = ''; closeModal(); render(); } else { smtMsg = t('restoreBad'); renderModal(); } });
    }
  } else if(el.dataset.cloud){
    if(!state.cloud) state.cloud = {url:'', pin:'', readPin:''};
    state.cloud[el.dataset.cloud] = el.value.trim(); persist();
  } else if(el.dataset.smtfile){
    if(e.type==='change'){
      Promise.all(Array.from(el.files || []).map(f => f.text())).then(texts => {
        let ok = 0, bad = 0; texts.forEach(tx => importProgress(tx) ? ok++ : bad++);
        smtMsg = ok + ' ' + t('impOk') + (bad ? ', ' + bad + ' ' + t('impBad') : ''); persist(); renderSmt();
      });
    }
  } else if(el.dataset.smtf){
    if(e.type==='change'){ smtF[el.dataset.smtf] = el.value; renderSmt(); }
  } else if(el.dataset.words){
    if(e.type==='change'){ state.words[el.dataset.words] = el.value; persist(); renderWords(); }
  } else if(el.dataset.prof){
    if(e.type==='change' && el.value) setUser(el.value);
  } else if(el.dataset.tt){
    if(e.type==='change'){
      const slot = state.timetable[el.dataset.d][+el.dataset.i];
      if(el.dataset.tt==='cls'){ const oldG = slot.cls ? slot.cls[0] : ''; slot.cls = el.value; if(!el.value || el.value[0] !== oldG) slot.subject = ''; }
      else slot.subject = el.value;
      persist(); renderTimetable();
    }
  } else if(el.dataset.lg){
    const p = +el.dataset.p, key = logDate + '|' + p;
    const d = drafts[key] = drafts[key] || draftFor(p);
    if(el.dataset.lg==='kw'){
      if(e.type==='change' && el.value){
        if(!d.kws.includes(el.value)){ d.kws.push(el.value); const sl = state.timetable[dayKey(logDate)][p - 1]; if(sl && sl.cls){ const all = subsFor(sl.cls[0], el.value); if(all.length) d.subs[el.value] = all.slice(); } }
        renderLog(); }
    } else d[el.dataset.lg] = el.value;
  } else if(el.dataset.logdate){
    if(e.type==='change' && el.value){ logDate = el.value; logNote = ''; renderLog(); }
  } else if(el.dataset.atp){
    const k = el.dataset.atp, s = state.atp.sel;
    s[k] = el.value;
    if(k==='grade'){ s.subject = ''; s.kw = ''; }
    if(k==='subject'){ s.kw = ''; }
    persist();
    if(e.type==='change' && k!=='date') { atpMsg = ''; renderAtp(); }
  } else if(el.dataset.flt){ state.filters[el.dataset.flt] = el.value; persist(); renderList(); }
  else if(el.dataset.dsh && e.type==='change'){ state.dash[el.dataset.dsh] = el.value; persist(); renderDash(); }
}
document.addEventListener('input', onField);
document.addEventListener('change', onField);
document.addEventListener('keydown', e => { if(e.key==='Escape' && (form || exportText!==null)) closeModal(); });

render();
initShared();
scheduleCloud();
if(LOCAL_SMT) cloudPoll = setInterval(function(){ if(state.tab==='smt' && state.cloud && state.cloud.url && state.cloud.readPin) loadCloud(); }, 60000);
if('serviceWorker' in navigator){ window.addEventListener('load', function(){ navigator.serviceWorker.register('sw.js').catch(function(){}); }); }
</script>
