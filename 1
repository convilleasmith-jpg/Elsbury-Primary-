<style>
:root{
  --bg:#F7F8FA;--surface:#FFFFFF;--ink:#17283D;--muted:#5B6B7E;--line:#D5DDE6;--soft:#E2E9F1;
  --brand:#4338CA;--on-brand:#FFFFFF;
  --A:#0F8B8D;--B:#3D5AA8;--C:#C4552D;--D:#7A3E8E;
  --ok:#2E7D4F;--warn:#B45309;--bad:#B3261E;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0E1721;--surface:#16222E;--ink:#E7EDF3;--muted:#9DAEC0;--line:#2B3C4E;--soft:#1F2E3D;
    --brand:#A5B4FC;--on-brand:#0E1721;
    --A:#3FC1C3;--B:#8AA5EC;--C:#F08A62;--D:#C58AD6;
    --ok:#5BC48A;--warn:#E3A445;--bad:#F2877F;
  }
}
:root[data-theme="dark"]{
  --bg:#0E1721;--surface:#16222E;--ink:#E7EDF3;--muted:#9DAEC0;--line:#2B3C4E;--soft:#1F2E3D;
  --brand:#A5B4FC;--on-brand:#0E1721;
  --A:#3FC1C3;--B:#8AA5EC;--C:#F08A62;--D:#C58AD6;
  --ok:#5BC48A;--warn:#E3A445;--bad:#F2877F;
}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font:15px/1.5 Inter,system-ui,-apple-system,"Segoe UI",sans-serif}
h1,h2,h3{font-family:Inter,system-ui,sans-serif;margin:0;line-height:1.2}
button,input,select,textarea{font:inherit;color:inherit}
.wrap{max-width:1000px;margin:0 auto;padding:16px}
header.top{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;margin-bottom:16px}
header.top h1{font-size:1.6rem;font-weight:700}
header.top p{margin:2px 0 0;color:var(--muted);font-size:.95rem}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--surface)}
.seg button{border:0;background:transparent;padding:8px 14px;cursor:pointer;min-height:40px}
.seg button[aria-pressed="true"]{background:var(--brand);color:var(--on-brand);font-weight:600}
.tabs{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap}
.tabs button{flex:1;min-width:130px;border:1px solid var(--line);background:var(--surface);padding:10px;border-radius:10px;cursor:pointer;font-weight:600;min-height:44px}
.tabs button[aria-selected="true"]{background:var(--brand);color:var(--on-brand);border-color:var(--brand)}
.btn{border:1px solid var(--line);background:var(--surface);padding:8px 14px;border-radius:10px;cursor:pointer;min-height:40px;font-weight:600}
.btn.primary{background:var(--brand);color:var(--on-brand);border-color:var(--brand)}
.btn.ok{background:var(--ok);color:#fff;border-color:var(--ok)}
.btn.danger{color:var(--bad);border-color:var(--bad)}
.btn.small{padding:4px 10px;min-height:34px;font-size:.9rem}
:focus-visible{outline:3px solid var(--brand);outline-offset:2px}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px;margin-bottom:16px}
.panel h2{font-size:1.15rem;margin-bottom:12px}
.grid{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(160px,1fr))}
.grid.one{grid-template-columns:1fr}
label.f{display:flex;flex-direction:column;gap:4px;font-size:.9rem;color:var(--muted);min-width:0}
label.f input,label.f select,label.f textarea,.field{border:1px solid var(--line);background:var(--bg);border-radius:8px;padding:8px 10px;min-height:42px;color:var(--ink);width:100%;max-width:100%}
textarea{min-height:72px;resize:vertical}
.toolbar{display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin-bottom:12px}
.toolbar .grow{flex:1;min-width:150px}
.count{color:var(--muted);font-size:.9rem;margin:8px 0}
.card{background:var(--surface);border:1px solid var(--line);border-left:7px solid var(--c);border-radius:12px;padding:12px 14px;margin-bottom:10px}
.card h3{font-size:1.05rem}
.card .strand{color:var(--c);font-weight:600;font-size:.9rem}
.meta{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0}
.chip{display:inline-block;border:1px solid var(--line);background:var(--soft);border-radius:999px;padding:1px 10px;font-size:.85rem}
.chip.od{border-color:var(--bad);color:var(--bad)}
.badge{font-size:.82rem;font-weight:600;border-radius:6px;padding:2px 8px;border:1px solid var(--line)}
.badge.planned{color:var(--muted)}
.badge.progress{color:var(--warn);border-color:var(--warn)}
.badge.done{color:var(--ok);border-color:var(--ok)}
.sum{color:var(--muted);font-size:.93rem;margin:4px 0}
.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
.bar{height:10px;background:var(--soft);border-radius:6px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--c,var(--brand))}
.row{display:grid;grid-template-columns:minmax(120px,1.4fr) 3fr auto;gap:10px;align-items:center;margin:10px 0}
table{width:100%;border-collapse:collapse;font-size:.95rem}
th,td{padding:8px 6px;border-bottom:1px solid var(--line);text-align:center;vertical-align:middle}
th:first-child,td:first-child{text-align:left}
.scroll{overflow-x:auto}
.empty{text-align:center;color:var(--muted);padding:28px 12px;border:1px dashed var(--line);border-radius:12px}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.tag{display:inline-flex;align-items:center;gap:4px;border:1px solid var(--c);background:var(--soft);border-radius:999px;padding:2px 4px 2px 12px}
.tag .x{border:0;background:transparent;cursor:pointer;font-weight:700;min-width:28px;min-height:28px;color:var(--bad)}
.modal{position:fixed;inset:0;background:rgba(10,20,30,.55);display:flex;align-items:flex-start;justify-content:center;padding:calc(12px + env(safe-area-inset-top,0px)) 12px calc(12px + env(safe-area-inset-bottom,0px));z-index:10}
.sheet{background:var(--surface);border-radius:14px;max-width:760px;width:100%;max-height:100%;overflow:auto;padding:16px;border-top:7px solid var(--c)}
.sheet h2{margin-bottom:12px}
.stage{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:6px 0;border-bottom:1px solid var(--line)}
.stage label{display:flex;gap:8px;align-items:center}
.stage input[type=date]{width:auto}
.sec{margin:14px 0 6px;font-weight:600}
.err{color:var(--bad);margin-top:8px}
.msg{color:var(--warn);margin:8px 0;font-weight:600}
.foot{display:flex;gap:8px;justify-content:flex-end;margin-top:16px;flex-wrap:wrap}
.note{color:var(--muted);font-size:.85rem;margin-top:16px}
.kw{display:flex;gap:10px;align-items:flex-start;padding:8px 0;border-bottom:1px solid var(--line)}
.kw .mark{font-weight:700;min-width:22px;color:var(--muted)}
.kw.is-done .mark{color:var(--ok)}
.kw .txt{flex:1}
.kw small{display:block;color:var(--muted)}
@media (max-width:560px){.row{grid-template-columns:1fr}}
.nav{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;margin-bottom:18px}
.brandbox{display:flex;align-items:center;gap:10px;font-weight:700}
.logo{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:10px;background:var(--brand);color:var(--on-brand)}
.mainnav{display:flex;gap:6px}
.navbtn{border:0;background:transparent;padding:8px 12px;border-radius:10px;cursor:pointer;font-weight:500;color:var(--muted);min-height:40px}
.navbtn[aria-pressed="true"]{background:color-mix(in srgb,var(--brand) 14%,var(--surface));color:var(--brand);font-weight:600}
.who{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.who b{font-weight:600}
.hello{font-size:1.9rem;font-weight:700;letter-spacing:-.02em}
.sub{margin:4px 0 16px;color:var(--muted)}
.subtabs{display:inline-flex;gap:2px;background:var(--soft);padding:3px;border-radius:10px;margin-bottom:16px;flex-wrap:wrap}
.subtabs button{border:0;background:transparent;padding:7px 14px;border-radius:8px;cursor:pointer;font-weight:500;color:var(--muted);min-height:38px}
.subtabs button[aria-selected="true"]{background:var(--surface);color:var(--ink);font-weight:600}
.cnt{font-size:.78rem;color:var(--muted);font-weight:400}
.banner{background:color-mix(in srgb,var(--brand) 10%,var(--surface));border:1px solid color-mix(in srgb,var(--brand) 25%,var(--line));color:var(--brand);border-radius:10px;padding:12px 14px;margin-bottom:14px}
.ttrow{display:grid;grid-template-columns:44px 110px 1fr;gap:8px;align-items:center;margin:8px 0}
.ttrow .pn{color:var(--muted);font-weight:600;font-size:.85rem}
.ttrow select{border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:8px 10px;min-height:42px;width:100%}
.datebar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:12px}
.datebar .sum{margin:0}
.pill{margin-left:auto;background:var(--ink);color:var(--bg);border-radius:999px;padding:3px 12px;font-size:.8rem;font-weight:600}
.pcard{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:14px;display:grid;gap:10px}
.phead{display:flex;gap:12px;align-items:center}
.pnum{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:9px;background:var(--ink);color:var(--bg);font-weight:700}
.logfoot{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}
.logfoot .field{flex:1;min-width:180px}
.pcard .field{border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:9px 12px;min-height:42px;width:100%}
.btn:disabled{opacity:.45;cursor:not-allowed}
.tick{color:var(--ok);font-weight:700;font-size:1.05rem}
.dt{display:block;color:var(--muted);font-size:.7rem}
.kwt th:not(:first-child),.kwt td:not(:first-child){width:64px;min-width:64px}
.kwt td:first-child{max-width:520px}
.sumrow td{background:var(--soft)}
.subs{border:1px solid var(--line);border-radius:10px;padding:10px 12px;display:grid;gap:6px;background:var(--bg)}
.sublab{display:flex;gap:8px;align-items:flex-start;font-size:.92rem;cursor:pointer}
.sublab input{margin-top:4px}
.ownrow{display:flex;gap:8px}
.ownrow .field{flex:1}
.smtrow td{vertical-align:top;text-align:left}
.ok-chip{border-color:var(--ok);color:var(--ok)}
.subl{color:var(--muted);font-size:.78rem;margin-top:3px;line-height:1.35}
.sectrow td{background:var(--soft);font-weight:600}
.sectrow td:first-child{border-left:4px solid var(--c)}
@media (max-width:560px){.ttrow{grid-template-columns:36px 90px 1fr}}

</style>
